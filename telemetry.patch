+           sizeof(local_playeringame));
+}
+
+int D_PromptFPSStepTics(int count)
+{
+    boolean old_singletics = singletics;
+    int i;
+
+    if (count < 0)
+        count = 0;
+    if (count > 256)
+        count = 256;
+
+    singletics = true;
+    for (i = 0; i < count; ++i)
+        TryRunTics();
+    singletics = old_singletics;
+
+    return count;
+}
